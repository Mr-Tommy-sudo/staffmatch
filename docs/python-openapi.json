  "components": {
    "schemas": {
      "Answer": {
        "properties": {
          "questionId": {
            "type": "string",
            "minLength": 1,
            "pattern": "[^\\t-\\r\\u001c-\\u0020\\u1680\\u2000-\\u2006\\u2008-\\u200a\\u2028\\u2029\\u205f\\u3000]",
            "title": "Questionid"
          },
          "selectedOptionIndex": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Selectedoptionindex"
          },
          "text": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 4000,
                "minLength": 1,
                "pattern": "[^\\t-\\r\\u001c-\\u0020\\u1680\\u2000-\\u2006\\u2008-\\u200a\\u2028\\u2029\\u205f\\u3000]"
              },
              {
                "type": "null"
              }
            ],
            "title": "Text"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "questionId"
        ],
        "title": "Answer"
      },
      "Breakdown": {
        "properties": {
          "competency": {
            "type": "string",
            "minLength": 1,
            "pattern": "[^\\t-\\r\\u001c-\\u0020\\u1680\\u2000-\\u2006\\u2008-\\u200a\\u2028\\u2029\\u205f\\u3000]",
            "title": "Competency"
          },
          "score": {
            "type": "number",
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Score"
          },
          "maxScore": {
            "type": "number",
            "maximum": 100.0,
            "exclusiveMinimum": 0.0,
            "title": "Maxscore"
          },
          "percent": {
            "type": "number",
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Percent"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "competency",
          "score",
          "maxScore",
          "percent"
        ],
        "title": "Breakdown"
      },
      "Candidate": {
        "properties": {
          "candidateId": {
            "type": "string",
            "minLength": 1,
            "pattern": "[^\\t-\\r\\u001c-\\u0020\\u1680\\u2000-\\u2006\\u2008-\\u200a\\u2028\\u2029\\u205f\\u3000]",
            "title": "Candidateid"
          },
          "city": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "City"
          },
          "workFormats": {
            "items": {
              "type": "string",
              "enum": [
                "REMOTE",
                "HYBRID",
                "OFFICE"
              ]
            },
            "type": "array",
            "minItems": 1,
            "title": "Workformats"
          },
          "availableHours": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 168.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Availablehours"
          },
          "salaryExpectation": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Salaryexpectation"
          },
          "experienceMonths": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Experiencemonths"
          },
          "portfolioAvailable": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Portfolioavailable"
          },
          "skills": {
            "items": {
              "$ref": "#/components/schemas/CandidateSkill"
            },
            "type": "array",
            "minItems": 1,
            "title": "Skills"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "candidateId",
          "workFormats",
          "skills"
        ],
        "title": "Candidate"
      },
      "CandidateSkill": {
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1,
            "pattern": "[^\\t-\\r\\u001c-\\u0020\\u1680\\u2000-\\u2006\\u2008-\\u200a\\u2028\\u2029\\u205f\\u3000]",
            "title": "Code"
          },
          "level": {
            "type": "integer",
            "maximum": 5.0,
            "minimum": 1.0,
            "title": "Level"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "code",
          "level"
        ],
        "title": "CandidateSkill"
      },
      "ChoiceQuestion": {
        "properties": {
          "questionId": {
            "type": "string",
            "minLength": 1,
            "pattern": "[^\\t-\\r\\u001c-\\u0020\\u1680\\u2000-\\u2006\\u2008-\\u200a\\u2028\\u2029\\u205f\\u3000]",
            "title": "Questionid"
          },
          "type": {
            "type": "string",
            "const": "SINGLE_CHOICE",
            "title": "Type",
            "default": "SINGLE_CHOICE"
          },
          "competency": {
            "type": "string",
            "minLength": 1,
            "pattern": "[^\\t-\\r\\u001c-\\u0020\\u1680\\u2000-\\u2006\\u2008-\\u200a\\u2028\\u2029\\u205f\\u3000]",
            "title": "Competency"
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "pattern": "[^\\t-\\r\\u001c-\\u0020\\u1680\\u2000-\\u2006\\u2008-\\u200a\\u2028\\u2029\\u205f\\u3000]",
            "title": "Text"
          },
          "options": {
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "[^\\t-\\r\\u001c-\\u0020\\u1680\\u2000-\\u2006\\u2008-\\u200a\\u2028\\u2029\\u205f\\u3000]"
            },
            "type": "array",
            "minItems": 2,
            "title": "Options"
          },
          "correctAnswer": {
            "$ref": "#/components/schemas/CorrectAnswer"
          },
          "maxScore": {
            "type": "integer",
            "maximum": 100.0,
            "minimum": 1.0,
            "title": "Maxscore"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "questionId",
          "competency",
          "text",
          "options",
          "correctAnswer",
          "maxScore"
        ],
        "title": "ChoiceQuestion"
      },
      "Competency": {
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1,
            "pattern": "[^\\t-\\r\\u001c-\\u0020\\u1680\\u2000-\\u2006\\u2008-\\u200a\\u2028\\u2029\\u205f\\u3000]",
            "title": "Code"
          },
          "weight": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Weight"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "code",
          "weight"
        ],
        "title": "Competency"
      },
      "CorrectAnswer": {
        "properties": {
          "optionIndex": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Optionindex"
          }
        },
        "additionalProperties": true,
        "type": "object",
        "required": [
          "optionIndex"
        ],
        "title": "CorrectAnswer"
      },
      "ErrorDetail": {
        "properties": {
          "field": {
            "type": "string",
            "title": "Field"
          },
          "message": {
            "type": "string",
            "title": "Message"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "field",
          "message"
        ],
        "title": "ErrorDetail"
      },
      "ErrorResponse": {
        "properties": {
          "requestId": {
            "type": "string",
            "title": "Requestid"
          },
          "status": {
            "type": "integer",
            "title": "Status"
          },
          "error": {
            "type": "string",
            "title": "Error"
          },
          "message": {
            "type": "string",
            "title": "Message"
          },
          "retryable": {
            "type": "boolean",
            "title": "Retryable"
          },
          "details": {
            "items": {
              "$ref": "#/components/schemas/ErrorDetail"
            },
            "type": "array",
            "title": "Details"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "requestId",
          "status",
          "error",
          "message",
          "retryable",
          "details"
        ],
        "title": "ErrorResponse"
      },
      "Explanation": {
        "properties": {
          "field": {
            "type": "string",
            "minLength": 1,
            "pattern": "[^\\t-\\r\\u001c-\\u0020\\u1680\\u2000-\\u2006\\u2008-\\u200a\\u2028\\u2029\\u205f\\u3000]",
            "title": "Field"
          },
          "code": {
            "type": "string",
            "minLength": 1,
            "pattern": "[^\\t-\\r\\u001c-\\u0020\\u1680\\u2000-\\u2006\\u2008-\\u200a\\u2028\\u2029\\u205f\\u3000]",
            "title": "Code"
          },
          "expected": {
            "title": "Expected"
          },
          "actual": {
            "title": "Actual"
          },
          "contribution": {
            "type": "number",
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Contribution"
          },
          "explanation": {
            "type": "string",
            "minLength": 1,
            "pattern": "[^\\t-\\r\\u001c-\\u0020\\u1680\\u2000-\\u2006\\u2008-\\u200a\\u2028\\u2029\\u205f\\u3000]",
            "title": "Explanation"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "field",
          "code",
          "expected",
          "actual",
          "contribution",
          "explanation"
        ],
        "title": "Explanation"
      },
      "FinalEntry": {
        "properties": {
          "candidateId": {
            "type": "string",
            "minLength": 1,
            "pattern": "[^\\t-\\r\\u001c-\\u0020\\u1680\\u2000-\\u2006\\u2008-\\u200a\\u2028\\u2029\\u205f\\u3000]",
            "title": "Candidateid"
          },
          "rank": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Rank"
          },
          "finalScore": {
            "type": "number",
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Finalscore"
          },
          "state": {
            "type": "string",
            "enum": [
              "FINAL",
              "NO_TEST"
            ],
            "title": "State"
          },
          "components": {
            "additionalProperties": {
              "type": "number",
              "maximum": 100.0,
              "minimum": 0.0
            },
            "type": "object",
            "title": "Components"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "candidateId",
          "rank",
          "finalScore",
          "state",
          "components"
        ],
        "title": "FinalEntry"
      },
      "GenerateRequest": {
        "properties": {
          "vacancyId": {
            "type": "string",
            "minLength": 1,
            "pattern": "[^\\t-\\r\\u001c-\\u0020\\u1680\\u2000-\\u2006\\u2008-\\u200a\\u2028\\u2029\\u205f\\u3000]",
            "title": "Vacancyid"
          },
          "mode": {
            "type": "string",
            "const": "AUTO",
            "title": "Mode"
          },
          "role": {
            "type": "string",
            "minLength": 1,
            "pattern": "[^\\t-\\r\\u001c-\\u0020\\u1680\\u2000-\\u2006\\u2008-\\u200a\\u2028\\u2029\\u205f\\u3000]",
            "title": "Role"
          },
          "level": {
            "type": "string",
            "minLength": 1,
            "pattern": "[^\\t-\\r\\u001c-\\u0020\\u1680\\u2000-\\u2006\\u2008-\\u200a\\u2028\\u2029\\u205f\\u3000]",
            "title": "Level"
          },
          "durationMinutes": {
            "type": "integer",
            "maximum": 10.0,
            "minimum": 5.0,
            "title": "Durationminutes"
          },
          "questionCount": {
            "type": "integer",
            "maximum": 8.0,
            "minimum": 6.0,
            "title": "Questioncount"
          },
          "competencies": {
            "items": {
              "$ref": "#/components/schemas/Competency"
            },
            "type": "array",
            "minItems": 1,
            "title": "Competencies"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "vacancyId",
          "mode",
          "role",
          "level",
          "durationMinutes",
          "questionCount",
          "competencies"
        ],
        "title": "GenerateRequest"
      },
      "GenerateResponse": {
        "properties": {
          "testId": {
            "type": "string",
            "minLength": 1,
            "pattern": "[^\\t-\\r\\u001c-\\u0020\\u1680\\u2000-\\u2006\\u2008-\\u200a\\u2028\\u2029\\u205f\\u3000]",
            "title": "Testid"
          },
          "generationVersion": {
            "type": "string",
            "minLength": 1,
            "pattern": "[^\\t-\\r\\u001c-\\u0020\\u1680\\u2000-\\u2006\\u2008-\\u200a\\u2028\\u2029\\u205f\\u3000]",
            "title": "Generationversion"
          },
          "estimatedDurationMinutes": {
            "type": "integer",
            "maximum": 10.0,
            "minimum": 5.0,
            "title": "Estimateddurationminutes"
          },
          "questions": {
            "items": {
              "$ref": "#/components/schemas/ChoiceQuestion"
            },
            "type": "array",
            "title": "Questions"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "testId",
          "generationVersion",
          "estimatedDurationMinutes",
          "questions"
        ],
